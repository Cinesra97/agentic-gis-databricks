# Copy to .env (git-ignored) and fill in what you need:   Copy-Item .env.example .env
# Never commit .env. Values set in the environment override values in this file.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Default data mode on startup: demo (offline synthetic sample) | local (ingested public data) | databricks
AGIS_MODE=demo
# Show the dataset-registration form in the sidebar (writes config/datasets.local.yaml)
AGIS_ADMIN_MODE=false

# ---------------------------------------------------------------------------
# LLM (default: local Ollama). Use "demo" for the deterministic planner (no LLM).
# ---------------------------------------------------------------------------
AGIS_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# For reasoning models such as qwen3, set to false to disable "thinking" output
# AGIS_OLLAMA_THINK=false
AGIS_LLM_TIMEOUT_S=240
AGIS_LLM_NUM_CTX=8192
# Fall back to the deterministic planner if the LLM is unreachable or returns invalid output
AGIS_LLM_FALLBACK_TO_RULES=true
# Highest dataset sensitivity whose metadata/result summaries may appear in LLM prompts
AGIS_LLM_MAX_SENSITIVITY=internal
# Non-local LLM endpoints are blocked unless your organization has approved them
AGIS_ALLOW_EXTERNAL_LLM=false
# Optional organization-approved OpenAI-compatible server (vLLM, llama.cpp server, LM Studio ...)
# AGIS_LLM_PROVIDER=openai_compatible
# AGIS_OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# AGIS_OPENAI_COMPAT_MODEL=Qwen2.5-7B-Instruct
# AGIS_OPENAI_COMPAT_API_KEY=

# ---------------------------------------------------------------------------
# Databricks (optional). Use a read-only identity (see docs/DATABRICKS.md).
# ---------------------------------------------------------------------------
# DATABRICKS_SERVER_HOSTNAME=adb-1234567890123456.7.azuredatabricks.net
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abcdef1234567890
# DATABRICKS_WAREHOUSE_ID=abcdef1234567890     # alternative to DATABRICKS_HTTP_PATH
# DATABRICKS_CATALOG=dsny_sandbox
# DATABRICKS_SCHEMA=egpmo_sandbox
# pat | oauth-u2m (browser login) | oauth-m2m (service principal; uv sync --extra databricks-auth)
# DATABRICKS_AUTH_TYPE=pat
# DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Query safety
# ---------------------------------------------------------------------------
AGIS_MAX_RESULT_ROWS=50000
AGIS_QUERY_TIMEOUT_S=120
# generated: approve LLM-written SQL and every Databricks query | always | never (testing only)
AGIS_SQL_APPROVAL=generated
AGIS_AUDIT_LOG_PATH=logs/audit.jsonl
AGIS_AUDIT_LOG_SQL=true

# ---------------------------------------------------------------------------
# Spatial & maps
# ---------------------------------------------------------------------------
AGIS_PROJECTED_CRS=EPSG:2263
# reference (local boundary/street names) | nyc_geosearch (sends only the place text to NYC Planning Labs GeoSearch)
AGIS_GEOCODER=reference
# Allow DuckDB to download its Spatial extension once (or: uv sync --extra duckdb-spatial-wheel for offline)
AGIS_DUCKDB_INSTALL_EXTENSIONS=true
# folium (Leaflet) | pydeck (deck.gl)
AGIS_MAP_RENDERER=folium
# local = vendored Leaflet JS/CSS served by Streamlit (works offline) | cdn
AGIS_MAP_ASSETS=local
AGIS_DEFAULT_BASEMAP=CARTO Dark Matter
# Organization tile server (XYZ template), e.g. an internal basemap
# AGIS_CUSTOM_BASEMAP_URL=https://tiles.example.gov/{z}/{x}/{y}.png
# AGIS_CUSTOM_BASEMAP_ATTRIBUTION=© Example Agency

# ---------------------------------------------------------------------------
# Public data ingestion (NYC Open Data / Socrata)
# ---------------------------------------------------------------------------
AGIS_SOCRATA_DOMAIN=data.cityofnewyork.us
# Optional free app token for higher rate limits
# SOCRATA_APP_TOKEN=
